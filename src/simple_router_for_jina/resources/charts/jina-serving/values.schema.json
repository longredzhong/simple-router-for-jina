{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "nameOverride",
    "commonLabels",
    "services",
    "serviceAccount",
    "gateway",
    "networkPolicy",
    "ingress"
  ],
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "role",
          "model",
          "image",
          "imagePullPolicy",
          "replicas",
          "containerPort",
          "servicePort",
          "env",
          "secretEnv",
          "readOnlyRootFilesystem",
          "resources"
        ],
        "properties": {
          "role": {
            "enum": ["embedding", "reranker"]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "imagePullPolicy": {
            "enum": ["Always", "IfNotPresent", "Never"]
          },
          "replicas": {
            "type": "integer",
            "minimum": 1
          },
          "containerPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "servicePort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "secretEnv": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "secretName", "secretKey"],
              "properties": {
                "name": {"type": "string"},
                "secretName": {"type": "string"},
                "secretKey": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "readOnlyRootFilesystem": {
            "type": "boolean"
          },
          "resources": {
            "type": "object",
            "required": ["cpu", "memory", "gpu"],
            "properties": {
              "cpu": {
                "type": "string"
              },
              "memory": {
                "type": "string"
              },
              "gpu": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "name"],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "gateway": {
      "type": "object",
      "required": ["enabled", "image", "replicas", "port"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "annotations", "host", "tlsSecretName"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "host": {
          "type": "string"
        },
        "tlsSecretName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
